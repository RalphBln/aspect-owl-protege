% This file contains FOL formulas that are in the tri-guarded fragment.

% Existential quantification over atom
fof(existential_atom,axiom,( ?[X,Y,Z,V,W]: (w(X,Y,Z,a,b,c,V,W)) )).

% Guarded, three variables
fof(guarded1,axiom,( ![X,Y,Z]: (a(X,Y,Z) => (r(X,Y) & s(Y,Z) & t(X,Z))) )).

% from Rudolph S, Simkus M. The Triguarded Fragment of First-Order Logic. In: EPiC Series in Computing [Internet]. EasyChair; 2018. p. 604–19. Available from: https://easychair.org/publications/paper/wlJ3
fof(rudolph1,axiom,( ![X,Y] : ((r1(X,a) & r2(Y,b)) => ?[Z] : (r3(X,Y,Z,c))) )).

% from Pratt-Hartmann 2023: Fragments of First-Order Logic (Book)

% p. 104 Some artists admire only beekeepers
fof(pratt1,axiom,( ?[X]: (artst(X) & (![Y]: (adm(X,Y) => bkpr(Y)))) )).

% p. 104 Every artist envies every beekeeper they admire
fof(pratt2,axiom,( ![X]: (artst(X) => ![Y]: (adm(X,Y) => (bkpr(Y) => env(X,Y)))) )).

% p. 105 Every artist admires every beekeeper
% (not in GF but in FO2 and therefore in TGF)
fof(pratt3,axiom,( ! [X] : ( artst(X) => ! [Y] : ( bkpr(Y) => adm(X, Y) ) ) )).

% p. 105 Some artist envies every bekeeper he does not admire
% (not in GF but in FO2 and therefore in TGF)
fof(pratt4,axiom,( ? [X] : ( artst(X) & ! [Y] : ( (bkpr(Y) & ~adm(X, Y)) => env(X, Y) ) ) )).

fof(combinedaspects,axiom, (
    ! [Aspect, Aspect1, Aspect2] : (
        ctxBind(Aspect, Aspect1, Aspect2) => (
            (hasAspectPart(Aspect, Aspect1) & hasAspectPart(Aspect, Aspect2)) =>
            ! [X, Y] : (r4(X, Y, Aspect) => r4(Y, X, Aspect))
        )
    )
)).

 fof(transitivity,axiom,(
     ! [A] :
     ( aspect1(A, top_concept) => (
         ! [B] :
         ( aspect2(B,A) => (
             ! [X,Y,Z] :
             ( ( related(X,Y)
                 & related(Y,Z) )
             => related(X,Z,B) ) ) ) ) ) )).
